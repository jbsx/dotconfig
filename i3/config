#autostart apps on a workspace (boot only). No `assign` rules, so new windows
# and popups follow normal behaviour (open on the focused workspace).
exec --no-startup-id i3-msg 'workspace number 1; exec /usr/bin/firefox'
exec --no-startup-id i3-msg 'workspace number 2; exec /usr/bin/alacritty; workspace number 1'

#webcam not working at full resolution. work around
#systemctl --user start virtualcam.service

# Compositor — REQUIRED for polybar to render (it uses a 32-bit ARGB window).
# Without a compositor the bar window maps but paints nothing.
exec --no-startup-id picom -b --config ~/.config/picom/picom.conf

# waybar is Wayland-only; replace with a bar of your choice on X11 (polybar/i3bar)
exec --no-startup-id ~/.config/polybar/launch.sh
exec --no-startup-id blueman-applet
exec --no-startup-id dunst
# sway `app_id` -> i3 `class`. Position converted from 96ppt -> px (may need tweaking).
for_window [class="pomodoro"] floating enable, sticky enable, border none, move to output HDMI-A-1, move absolute position 3378 px 0 px
